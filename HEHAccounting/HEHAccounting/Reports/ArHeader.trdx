<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="8.101in" Name="Invoice" xmlns="http://schemas.telerik.com/reporting/2021/2.0">
  <Style BackgroundColor="White" />
  <DataSources>
    <SqlDataSource QueryDesignerState="" ParameterValues="null" ConnectionString="HEHAccounting.My.MySettings.HEAccountingReportDB" SelectCommand="SELECT&#xD;&#xA;&#x9;[CompanyInfo].[CompanyName], &#xD;&#xA;&#x9;[CompanyInfo].[Address], &#xD;&#xA;&#x9;[CompanyInfo].[Phone], &#xD;&#xA;&#x9;[CompanyInfo].[CellPhone], &#xD;&#xA;&#x9;[CompanyInfo].[LatinAddress], &#xD;&#xA;&#x9;[CompanyInfo].[LatinName], &#xD;&#xA;&#x9;[CompanyInfo].[Email],&#xD;&#xA;&#x9;[CompanyInfo].[CompPic]&#xD;&#xA;FROM [CompanyInfo]" Name="sqlDataSource1" />
  </DataSources>
  <Items>
    <DetailSection KeepTogether="False" Height="0.052in" Name="detail">
      <Style Visible="False" />
    </DetailSection>
    <ReportHeaderSection Height="1.3in" Name="reportHeaderSection1">
      <Items>
        <PictureBox Value="= Fields.CompPic" Width="2.1in" Height="1in" Left="5.8in" Top="0.2in" Sizing="Stretch" MimeType="" Name="pictureBox2" />
        <TextBox Width="2.783in" Height="0.371in" Left="2.659in" Top="0in" Value="= Fields.CompanyName" Name="textBox2">
          <Style Color="Black" TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="16pt" Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="2.783in" Height="0.29in" Left="2.659in" Top="0.4in" Value="= Fields.Address" Name="textBox4">
          <Style Color="Black" TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="11pt" Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="2.783in" Height="0.29in" Left="2.659in" Top="0.69in" Value="{Fields.CellPhone} - {Fields.Phone}" Name="textBox3">
          <Style Color="Black" TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="11pt" Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="2.783in" Height="0.29in" Left="2.659in" Top="0.98in" Value="= Fields.Email" Name="textBox5">
          <Style Color="Black" TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="11pt" Bold="True" />
          </Style>
        </TextBox>
      </Items>
    </ReportHeaderSection>
  </Items>
  <PageSettings PaperKind="A4" Landscape="False">
    <Margins>
      <MarginsU Left="0in" Right="0in" Top="0.3in" Bottom="0.4in" />
    </Margins>
  </PageSettings>
  <StyleSheet>
    <StyleRule>
      <Style>
        <Padding Left="2pt" Right="2pt" />
      </Style>
      <Selectors>
        <TypeSelector Type="TextItemBase" />
        <TypeSelector Type="HtmlTextBox" />
      </Selectors>
    </StyleRule>
    <StyleRule>
      <Style>
        <Font Name="Segoe UI" Size="10pt" />
      </Style>
      <Selectors>
        <TypeSelector Type="TextBox" />
      </Selectors>
    </StyleRule>
    <StyleRule>
      <Style>
        <Font Name="Segoe UI Light" Size="16pt" Bold="True" />
        <Padding Left="0in" />
      </Style>
      <Selectors>
        <StyleSelector Type="ReportItemBase" StyleName="Header" />
      </Selectors>
    </StyleRule>
  </StyleSheet>
</Report>