<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource2" Width="205mm" Name="InvSalesOrders" xmlns="http://schemas.telerik.com/reporting/2019/2.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="" ParameterValues="null" ConnectionString="HEHAccounting.My.MySettings.ConnectionString" SelectCommand="SELECT&#xD;&#xA;&#x9;[DetailSalesInvoices].[ID], &#xD;&#xA;&#x9;[DetailSalesInvoices].[InvID], &#xD;&#xA;&#x9;[DetailSalesInvoices].[Qty], &#xD;&#xA;&#x9;[DetailSalesInvoices].[SellingPrice], &#xD;&#xA;&#x9;[DetailSalesInvoices].[PurchasingPrice], &#xD;&#xA;&#x9;[DetailSalesInvoices].[ItemDiscount], &#xD;&#xA;&#x9;[DetailSalesInvoices].[Total], &#xD;&#xA;&#x9;[DetailSalesInvoices].[Net], &#xD;&#xA;&#x9;[DetailSalesInvoices].[ItemID], &#xD;&#xA;&#x9;[Items].[Item_id], &#xD;&#xA;&#x9;[Items].[Item_name], &#xD;&#xA;&#x9;[Items].[Qty] AS &quot;ItemsQty&quot;, &#xD;&#xA;&#x9;[Items].[PurchasingPrice] AS &quot;ItemsPurchasingPrice&quot;, &#xD;&#xA;&#x9;[Items].[SellingPrice] AS &quot;ItemsSellingPrice&quot;, &#xD;&#xA;&#x9;[Items].[Barcode], &#xD;&#xA;&#x9;[Items].[CreatedDate], &#xD;&#xA;&#x9;[Items].[LastUpdatePriceDate], &#xD;&#xA;&#x9;[Items].[LastPurchasingPrice], &#xD;&#xA;&#x9;[Items].[SellInvoicePriceNum], &#xD;&#xA;&#x9;[Items].[MinQty], &#xD;&#xA;&#x9;[Items].[SellingPricePercent], &#xD;&#xA;&#x9;[Items].[Picture], &#xD;&#xA;&#x9;[Items].[GroupID], &#xD;&#xA;&#x9;[Items].[ExpiredDate], &#xD;&#xA;&#x9;[Items].[IsHasExpiredDate], &#xD;&#xA;&#x9;[Items].[IsAlertExpiredDate], &#xD;&#xA;&#x9;[Items].[IsAlertMinQty], &#xD;&#xA;&#x9;[Items].[IsAlertQtyOnBuy], &#xD;&#xA;&#x9;[Items].[ItemLatinName], &#xD;&#xA;&#x9;[Items].[ModifiedDate], &#xD;&#xA;&#x9;[SalesInvoices].[InvID] AS &quot;SalesInvoicesInvID&quot;, &#xD;&#xA;&#x9;[SalesInvoices].[InvDate], &#xD;&#xA;&#x9;[SalesInvoices].[InvCustomerID], &#xD;&#xA;&#x9;[SalesInvoices].[InvPaymentType], &#xD;&#xA;&#x9;[SalesInvoices].[InvDesc], &#xD;&#xA;&#x9;[SalesInvoices].[InvType]&#xD;&#xA;FROM (([DetailSalesInvoices]&#xD;&#xA; INNER JOIN [Items]&#xD;&#xA; ON [DetailSalesInvoices].[ItemID] = [Items].[Item_id] AND [Items].[Item_id] = [Items].[Item_id])&#xD;&#xA; INNER JOIN [SalesInvoices]&#xD;&#xA; ON [DetailSalesInvoices].[InvID] = [SalesInvoices].[InvID])" Name="sqlDataSource2" />
  </DataSources>
  <Items>
    <PageHeaderSection Height="1in" Name="pageHeaderSection1">
      <Items>
        <PictureBox Width="2.3in" Height="1in" Left="0in" Top="0in" Name="pictureBox1" />
      </Items>
    </PageHeaderSection>
    <DetailSection Height="2.6in" Name="detailSection1">
      <Items>
        <Panel Width="8.071in" Height="2.6in" Left="0in" Top="0in" Docking="None" Name="panel1" />
      </Items>
    </DetailSection>
    <PageFooterSection Height="1in" Name="pageFooterSection1" />
  </Items>
  <PageSettings PaperKind="A4" Landscape="False" ColumnCount="1" ColumnSpacing="0in" ContinuousPaper="False">
    <Margins>
      <MarginsU Left="1mm" Right="1mm" Top="1mm" Bottom="1mm" />
    </Margins>
  </PageSettings>
  <StyleSheet>
    <StyleRule>
